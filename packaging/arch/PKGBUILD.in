pkgname=cockpit-security
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit module for viewing and tracking host vulnerabilities'
arch=('x86_64')
url='https://github.com/cockpit-project/security'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
